{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeminiIntentExtractionContract",
  "description": "Structured JSON schema enforced on Google Gemini API output during Stage 1 intent understanding",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["recommend", "support", "compare", "out_of_scope", "general"],
      "description": "Primary classified intent of the user's message"
    },
    "requirements": {
      "type": "object",
      "description": "Extracted shopping filters when intent is 'recommend'",
      "properties": {
        "budget_max": {
          "type": ["number", "null"],
          "description": "Maximum budget ceiling extracted in INR (e.g. 60000)"
        },
        "budget_min": {
          "type": ["number", "null"],
          "description": "Minimum budget threshold extracted in INR"
        },
        "brand": {
          "type": ["string", "null"],
          "description": "Preferred laptop brand (e.g. 'HP', 'Lenovo', 'Dell', 'VoltKart')"
        },
        "usage_type": {
          "type": ["string", "null"],
          "enum": ["student", "coding", "gaming", "business", "general", null],
          "description": "Categorized usage pattern"
        },
        "min_ram_gb": {
          "type": ["integer", "null"],
          "description": "Minimum required RAM in gigabytes (e.g. 16)"
        },
        "min_storage_gb": {
          "type": ["integer", "null"],
          "description": "Minimum required storage in gigabytes (e.g. 512)"
        },
        "processor_preference": {
          "type": ["string", "null"],
          "description": "Specific processor requested (e.g. 'Intel i7', 'Ryzen 5')"
        },
        "battery_preference": {
          "type": ["string", "null"],
          "description": "e.g. 'high', 'long'"
        },
        "weight_preference": {
          "type": ["string", "null"],
          "description": "e.g. 'lightweight', 'thin'"
        }
      },
      "additionalProperties": false
    },
    "support_query": {
      "type": "object",
      "description": "Support parameters when intent is 'support'",
      "properties": {
        "category": {
          "type": ["string", "null"],
          "enum": ["return", "refund", "warranty", "shipping", "payment", "general", null]
        },
        "search_keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Extracted search terms for MongoDB text search"
        }
      },
      "additionalProperties": false
    },
    "comparison_targets": {
      "type": "object",
      "description": "Comparison parameters when intent is 'compare'",
      "properties": {
        "positions": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Relative ordinal numbers referenced, e.g. [1, 2] for 'compare the first two'"
        },
        "product_names": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Named models if explicitly typed, e.g. ['VoltBook Pro 15', 'IdeaPad 3']"
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of the intent classification"
    }
  },
  "required": ["intent"],
  "additionalProperties": false
}
